DATABASE_URL=postgres://user:pass@host:5432/db
JWT_SECRET=replace_with_long_random
PRINT_PROVIDER=cloud
PRINT_CLOUD_URL=https://printer-cloud.example.com/print
PRINT_CLOUD_API_KEY=replace_if_cloud
PRINT_AGENT_URL=http://print-agent.local:3001/print
PRINT_AGENT_TOKEN=replace_if_agent
XPYUN_API_URL=https://open.xpyun.net/api/openapi/xprinter/print
XPYUN_USER=replace_if_xpyun
XPYUN_USER_KEY=replace_if_xpyun
XPYUN_SN=replace_if_xpyun
XPYUN_COPIES=1
XPYUN_VOICE=2
XPYUN_FONT_TAG=B
XPYUN_MODE=
PRINT_FORCE_SINGLE_COPY=true
PRINT_WORKER_KEY=replace_with_worker_key
# Only the separately started cloud dispatcher uses this root URL.
PRINT_DISPATCH_ORIGIN=https://your-backend.example.com
PRINT_FALLBACK_PROVIDER=
PRINT_SPLIT_BY_TARGET=false
PRINT_TIMEOUT_MS=3000
PRINT_WAKE_ON_ORDER=true
PRINT_STALE_PRINTING_SECONDS=45
PRINT_RETRY_DELAY_SECONDS=12
PRINT_MAX_RETRY=8
PRINT_ALERT_FAIL_COUNT=3
PRINT_ALERT_QUEUE_FAILED=3
PRINT_ROUTE_BAR_CATEGORIES=
PRINT_ROUTE_BAR_KEYWORDS=
DEVICE_HEARTBEAT_KEY=
ORDER_DEDUPE_WINDOW_SECONDS=8
