{
  "name": "rdv-order",
  "version": "1.1.1",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:print-env": "node scripts/check-print-env.js",
    "worker:print": "node scripts/print-dispatcher.mjs",
    "lint": "tsc --noEmit",
    "test": "VITE_CJS_IGNORE_WARNING=true vitest run",
    "test:watch": "VITE_CJS_IGNORE_WARNING=true vitest",
    "verify": "npm run lint && npm run test && npm run build",
    "precommit:baseline": "npm run verify",
    "android:resources": "node scripts/android/sync-resources.mjs",
    "android:verify": "bash scripts/android/verify.sh",
    "android:apk": "bash scripts/android/package.sh",
    "android:stage-release": "node scripts/android/stage-release.mjs"
  },
  "dependencies": {
    "jose": "^5.9.4",
    "next": "15.5.25",
    "pg": "^8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "25.2.3",
    "@types/pg": "^8.16.0",
    "@types/react": "19.2.14",
    "pdf-parse": "^2.4.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
