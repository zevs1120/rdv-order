# Optional override for ingestion config location
INGEST_CONFIG_PATH=config/ingestion.config.json

# SQLite path (default from config)
DB_PATH=./data/quant.db

# Optional symbol overrides
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
US_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,TSLA

# API port for local query service
PORT=8787

# AI provider selection: groq (default) | gemini | openai | ollama
AI_PROVIDER=groq
CHAT_PROVIDER=groq

# GroqCloud Free-tier API key (no credit card required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional local fallback model (used when configured + available)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Optional internal tools base URL:
# Expected endpoints (POST JSON): /getSignalCards /getSignalDetail /getMarketTemperature /getRiskProfile
INTERNAL_API_BASE_URL=

# Chat rate limit per user
CHAT_RATE_LIMIT_MAX=18
CHAT_RATE_LIMIT_WINDOW_MS=60000
